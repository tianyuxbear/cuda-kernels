# ============================================================================
# C Files Configuration
# ============================================================================
If:
  PathMatch: .*\.(c|h)$
CompileFlags:
  Compiler: /usr/bin/gcc

---

# ============================================================================
# C++ Files Configuration
# ============================================================================
If:
  PathMatch: .*\.(c|h)pp
CompileFlags:
  Compiler: /usr/bin/g++

---

# ============================================================================
# CUDA Files Configuration
# ============================================================================
If:
  PathMatch: .*\.cuh?
CompileFlags:
  Compiler: /usr/local/cuda/bin/nvcc
  
  Add:
    # Error reporting
    - "-ferror-limit=0"  # Report all errors without limit
  
  Remove:
    # -------------------- CUDA Fatbin Arguments --------------------
    - "-Xfatbin*"
    
    # -------------------- CUDA Architecture Flags ------------------
    - "-gencode*"
    - "--generate-code*"
    
    # -------------------- CUDA Compiler Options --------------------
    - "-ccbin*"
    - "--compiler-options*"
    
    # -------------------- CUDA Language Extensions -----------------
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    
    # -------------------- CUDA Compilation Control -----------------
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    
    # -------------------- CUDA Debug Information -------------------
    - "-G"                        # Generate debug information for device code
    - "--generate-line-info"      # Generate line number information
  
# UI/UX Settings
Hover:
  ShowAKA: No  # Don't show "also known as" in hover information
  
InlayHints:
  Enabled: No  # Disable inline type hints
  
# Diagnostics Configuration
Diagnostics:
  Suppress:
      - "variadic_device_fn"      # Suppress variadic device function warnings
      - "attributes_not_allowed"  # Suppress attribute warnings

---

# ============================================================================
# Global Configuration (All Files)
# ============================================================================
CompileFlags:
  Add:
    # Error reporting
    - "-ferror-limit=0"  # Report all errors without limit

Hover:
  ShowAKA: No  # Don't show "also known as" in hover information

InlayHints:
  Enabled: No  # Disable inline type hints